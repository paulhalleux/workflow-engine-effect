{
  "name": "@workflow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "generate:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:3000/openapi.json} -o src/api/schema.ts && oxfmt src/api/schema.ts --write",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@dagrejs/dagre": "^2.0.4",
    "@tanstack/react-query": "^5.89.0",
    "@xyflow/react": "^12.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@paulhalleux/oxfmt-config": "workspace:*",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "oxfmt": "^0.68.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
